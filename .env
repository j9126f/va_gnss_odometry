# Identificação do grupo e da gravação (nome do bag: <GRUPO>_<sensores>_<data>_<PERCURSO>)
GRUPO=g07
# Valor provisório; o oficial é fixado no repositório comum
ROS_DOMAIN_ID=42
PERCURSO=exterior1

# Ligação ao recetor
# USB/série: deixar OEM7_IP vazio; OEM7_DEVICE vazio = deteção automática
OEM7_IP=
OEM7_PORT=
OEM7_IF=
OEM7_DEVICE=/dev/serial/by-id/usb-FTDI_UC232R_FTF91LQC-if00-port0
OEM7_BAUD=230400

# Pasta dos bags (no carro, apontar para o SSD externo)
DATA_DIR=./data

# CAN bus do carro (adaptador USB2CAN 8devices -> interface SocketCAN)
CAN_IF=can0
CAN_BITRATE=500000
# 1 = só escuta (não transmite nem confirma tramas): não interfere com o carro
CAN_LISTEN_ONLY=1

# Ângulo de direção (descobrir com: docker compose run --rm can can_identificar.py)
# Mitsubishi i-MiEV: 0x236, bytes 0-1 big-endian (centro 4081, batente esq. 5336, dir. 2970; identificado 2026-11-18)
# Escala: 2,75 voltas de batente a batente contadas no volante = 990º / 2366 unidades = 0,4184 º/unidade
# Relação: estimativa (entre-eixos 2,55 m, raio de viragem 4,5 m -> rodas ~34,5º com volante a ~495º); afinar com dados do INS
# Vazio = grava só as tramas brutas (/can/raw); dá para descodificar depois com ler_can.py
CAN_DIRECAO_ID=0x236
CAN_DIRECAO_EXT=0
CAN_DIRECAO_BIT=7
CAN_DIRECAO_BITS=16
CAN_DIRECAO_ORDEM=motorola
CAN_DIRECAO_SINAL=0
CAN_DIRECAO_ESCALA=0.418428
CAN_DIRECAO_OFFSET=-1707.6
CAN_DIRECAO_SENTIDO=1
# Desmultiplicação volante -> rodas (1 se o CAN já der o ângulo das rodas; tipicamente 14-17 se der o do volante)
CAN_RELACAO_DIRECAO=14.3

# Bag a reproduzir com --profile reproduzir (pasta dentro de ./data) e tópicos a usar
BAG=g00_gnss-ins_20261113_140141_teste1
TOPICOS=/novatel/oem7/inspva /novatel/oem7/fix /novatel/oem7/odom /novatel/oem7/bestpos /novatel/oem7/bestvel /novatel/oem7/rawimusx /tf /tf_static
