# Identificação da gravação (nome do bag: <GRUPO>_gnss-ins_<data>_<PERCURSO>)
GRUPO=g00
PERCURSO=teste

# Ligação ao recetor
# USB/série: deixar OEM7_IP vazio; OEM7_DEVICE vazio = deteção automática
OEM7_IP=
OEM7_PORT=
OEM7_IF=
OEM7_DEVICE=/dev/ttyUSB0
OEM7_BAUD=230400

# Pasta dos bags (no carro, apontar para o SSD externo)
DATA_DIR=./data
